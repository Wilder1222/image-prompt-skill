{
  "subject_kind": "character",
  "request": "仅编写原创成年全身人物提示词：明确8.5头身、修长协调、细腰与自然饱满臀部曲线，牛仔外套、羊毛针织内搭与真丝围巾各有真实材质和自然垂感。不生成图像。",
  "references": [],
  "unresolved": [],
  "requirements": [
    {
      "id": "identity",
      "channel": "identity",
      "priority": "must",
      "text": "原创成年人物，面容自然协调，脸型与五官内部关系稳定；后续改衣装或身体造型时不改人物身份。"
    },
    {
      "id": "costume",
      "channel": "costume",
      "priority": "must",
      "text": "深靛蓝牛仔外套，内搭米白羊毛针织衫，搭配窄幅灰蓝真丝围巾；衣领、袖口与接缝清楚，整体设计克制。"
    },
    {
      "id": "layout",
      "channel": "composition",
      "priority": "must",
      "text": "单人完整全身，正面自然站立，头顶至足底完整入画，浅中性背景，柔和光线。"
    },
    {
      "id": "BODY:head_shoulders",
      "channel": "proportion",
      "priority": "must",
      "text": "头部、肩带与完整身体协调，肩颈自然连接，保留人物脸型与五官内部关系。"
    },
    {
      "id": "BODY:torso_pelvis",
      "channel": "proportion",
      "priority": "must",
      "text": "胸廓、腰腹和骨盆结构完整连续，腰胯体积自然，不靠压短躯干凑长腿。"
    },
    {
      "id": "BODY:arms",
      "channel": "proportion",
      "priority": "must",
      "text": "上臂、肘、前臂、腕手长度与厚度协调，姿势自然。"
    },
    {
      "id": "BODY:legs",
      "channel": "proportion",
      "priority": "must",
      "text": "大腿、膝、小腿与足部成组协调，保留腿部体积和自然膝位。"
    },
    {
      "id": "BODY:support",
      "channel": "proportion",
      "priority": "must",
      "text": "肌肉与软组织随承重自然收缩放松，足底接触与重心可信。"
    },
    {
      "id": "BODY:silhouette",
      "channel": "proportion",
      "priority": "must",
      "text": "整体修长舒展，轮廓和服装体积统一，鞋跟、衣摆与头饰不冒充人体高度。"
    },
    {
      "id": "BODY:layout",
      "channel": "composition",
      "priority": "must",
      "text": "画面内需分别检查的全身人物共1个：单人完整全身。每个人物分别遵守共同身体方案，不能用其中一人代替其余人物。"
    },
    {
      "id": "CQ:elongated",
      "channel": "proportion",
      "priority": "must",
      "character_goal": "elongated",
      "text": "头肩、完整躯干与四肢共同形成修长协调的全身轮廓，比例造型按本轮明确数值；保持脸型和五官内部关系。"
    },
    {
      "id": "CQ:slender",
      "channel": "proportion",
      "priority": "must",
      "character_goal": "slender",
      "text": "腰身自然收束、腰胯连续，保留躯干厚度和指定体型，衣带与服装腰线不替代人体腰位。"
    },
    {
      "id": "CQ:muscle",
      "channel": "proportion",
      "priority": "must",
      "character_goal": "muscle",
      "text": "肌肉与软组织的体积、线条和支撑适配年龄与当前动作，不画细杆四肢或穿透衣料的肌肉。"
    },
    {
      "id": "CQ:hair_natural",
      "channel": "hair",
      "priority": "must",
      "character_goal": "hair_natural",
      "text": "保持本套主要发型；发根与发际线衔接自然，主发量有体积，次级发束粗细疏密有变化，发梢自然收束，高光随朝向变化，避免硬壳、胶结和等距亮丝。"
    },
    {
      "id": "CQ:face_readable",
      "channel": "hair",
      "priority": "must",
      "character_goal": "face_readable",
      "text": "本视角实际可见的眉眼、鼻口与面容辨识点清楚，禁止过多碎发遮脸；少量细发留在鬓角和轮廓边缘，不为整洁抹去全部自然细发。"
    },
    {
      "id": "FIG:body",
      "channel": "proportion",
      "priority": "must",
      "text": "身材造型目标为 8.5 头身：按颅顶至下巴的头长协调完整身体，不计发量、头饰、鞋跟和拖尾。整体修长舒展，呈现黄金比例的均衡美感，细腰自然收束，臀部曲线自然饱满且与骨盆连续，躯干完整，肩颈与上下肢段协调，保留肌肉和软组织厚度；不靠极端缩头、纸片腰或单段拉腿凑比例。保持脸型与五官内部关系、人物身份和当前媒介。",
      "target_head_count": 8.5
    },
    {
      "id": "FIG:fabric:coat",
      "channel": "material",
      "priority": "must",
      "text": "深靛蓝外套采用棉质牛仔布，中厚、较重；较挺括，衣摆受自重下垂，接缝处保留支撑，肘膝与坐折处形成较宽的折线和受力堆褶。沿用指定衣片、缝线、叠压和穿着关系，不以换材质或统一轻薄飘逸改变服装设计。"
    },
    {
      "id": "FIG:fabric:knit",
      "channel": "material",
      "priority": "must",
      "text": "米白内搭采用羊毛针织，中等厚度、中等重量；柔软且有弹性，自重下垂，肩部与袖口保留回弹，弯曲处形成圆缓褶皱，针目随伸展轻微张开。沿用指定衣片、缝线、叠压和穿着关系，不以换材质或统一轻薄飘逸改变服装设计。"
    },
    {
      "id": "FIG:fabric:scarf",
      "channel": "material",
      "priority": "must",
      "text": "灰蓝围巾采用真丝素绉缎，薄、轻；柔顺贴合，沿悬垂方向自然落下，反光随面料朝向移动，形成细软流动褶皱，缝边和叠压处有克制厚度。沿用指定衣片、缝线、叠压和穿着关系，不以换材质或统一轻薄飘逸改变服装设计。"
    }
  ],

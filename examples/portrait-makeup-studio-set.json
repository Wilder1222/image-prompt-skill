      "id": "head_shoulders_warm_makeup",
      "label": "头肩定妆：暖小麦肤色女性与铜棕眼妆",
      "scope": "原创三十三岁现代女性；头肩近景用于妆肤细节。年龄、脸型、肤色、妆色与衣装只属于本例。",
      "brief": {
        "subject_kind": "character",
        "request": "为一位原创三十三岁女性设计纯白背景的头肩定妆照，暖小麦肤色、铜棕眼妆与栗棕缎光唇妆，面容妆肤清楚，保留衣领和耳饰。本例仅编译文字，不执行图像生成。",
        "references": [],
        "unresolved": [],
        "requirements": [
          {
            "id": "head_shoulders_warm_makeup-task",
            "channel": "task",
            "priority": "must",
            "text": "生成一张单人竖幅头肩定妆照，纯白无缝棚背景，重点展示面容与妆肤，完整保留主要发型、衣领和耳饰。画面无文字、色卡、水印或拼板。"
          },
          {
            "id": "head_shoulders_warm_makeup-style",
            "channel": "style",
            "priority": "must",
            "text": "采用精致的现代演员定妆摄影观感，适度理想化但保留成年面容结构、可信皮肤和衣饰材质，细节清楚，整体协调自然。"
          },
          {
            "id": "head_shoulders_warm_makeup-identity",
            "channel": "identity",
            "priority": "must",
            "text": "三十三岁女性，暖小麦基础肤色，略方的椭圆脸，额头与颊部饱满，下颌有柔和转折。双眼横向稍长，外眼角平缓，上眼睑褶皱清楚，深棕虹膜。自然眉毛较浓，鼻梁高度适中、鼻翼有自然宽度，上下唇体积均衡。鼻梁与上颊保留少量浅雀斑，左右眉峰有轻微自然差异。"
          },
          {
            "id": "head_shoulders_warm_makeup-expression",
            "channel": "expression",
            "priority": "must",
            "text": "目光平稳看向镜头，眼睑自然舒展，眉间放松，双唇轻合，嘴角放松，神态安静专注。"
          },
          {
            "id": "head_shoulders_warm_makeup-makeup",
            "channel": "makeup",
            "priority": "must",
            "text": "薄透底妆均匀暖小麦肤色，鼻梁与上颊的浅雀斑仍可辨，面颊与颈部自然衔接。铜棕眼影薄薄覆盖上眼皮，外眼角稍深，向眉骨下方柔和消退；深棕内眼线贴合睫毛根部，眼尾短而平缓，睫毛纤细分明。低饱和杏棕腮红从面颊中央向外轻轻晕开，边缘融入肤色。栗棕唇色中央略深、唇缘柔和，表面呈克制缎光，下唇有小面积柔亮反射并保留细小唇纹。面颊以半哑光和低对比微纹理为主。"
          },
          {
            "id": "head_shoulders_warm_makeup-hair",
            "channel": "hair",
            "priority": "must",
            "text": "深棕短卷发自然贴合头形，主发束有清楚走向，额前少量细发不遮住眉眼。人物双耳佩戴小巧圆环耳饰，轮廓完整。"
          },
          {
            "id": "head_shoulders_warm_makeup-costume",
            "channel": "costume",
            "priority": "must",
            "text": "暖白色小翻领衬衫搭配深青绿色外套，仅展示衣领与肩部衣片，领口结构简洁、连接清楚。"
          },
          {
            "id": "head_shoulders_warm_makeup-material",
            "channel": "material",
            "priority": "must",
            "text": "皮肤半哑光、唇部缎光、衬衫柔和漫反射与小耳环局部金属亮点分别可辨。衣领保留面料厚度、接缝及柔和衣褶，不用全图锐化增加颗粒。"
          },
          {
            "id": "head_shoulders_warm_makeup-composition",
            "channel": "composition",
            "priority": "must",
            "text": "平视、头部正对镜头，从完整主发束拍至双肩上缘下方与衣领，面容占据主要可读区域。头顶和左右耳饰外缘留有舒适余量，左右肩部保留自然连接，画面下沿位于衣领以下，身体朝向与头部一致。"
          },
          {
            "id": "head_shoulders_warm_makeup-proportion",
            "channel": "proportion",
            "priority": "must",
            "text": "头脸与肩宽相称，颈部长度自然，颌颈、锁骨与肩带连接连续，肩线舒展，保留柔和软组织体积。只评价当前可见头肩关系。",
            "character_goal": "elongated"
          },
          {
            "id": "head_shoulders_warm_makeup-background",
            "channel": "background",
            "priority": "must",
            "text": "纯白无缝背景均匀洁净，白色衣领通过柔和转折、衣褶和边缘层次与背景分离，衣料高光仍有细节。"
          },
          {
            "id": "head_shoulders_warm_makeup-lighting",
            "channel": "lighting",
            "priority": "must",
            "text": "近正面、略高于视线的大面积柔光主光，另一侧前方提供较弱的宽面积补光。眼窝明亮，鼻翼、下唇与下颌下方保留浅淡阴影，面颊体积连续。双眼反射与同一套光源相容，眉睫、唇缘、雀斑与衣领清楚，柔和来自受光过渡。中性白平衡保留暖小麦肤色和铜棕妆色，深青绿外套在领边可有轻微局部反色，脸部整体不泛绿。背景亮度与皮肤曝光分别控制。"
          },
          {
            "id": "CQ:slender",
            "channel": "proportion",
            "priority": "must",
            "character_goal": "slender",
            "text": "实际可见的身形苗条利落，轮廓自然收束且有连续厚度，不削成纸片或露骨细杆；衣装沿既定结构呈现。"
          },
          {
            "id": "CQ:muscle",
            "channel": "proportion",
            "priority": "must",
            "character_goal": "muscle",
            "text": "实际可见的身体适当有肌肉与软组织支撑，线条紧致舒展，不过分硬刻或夸大肌肉，不穿透衣装推断隐藏结构。"
          },
          {
            "id": "CQ:hair_natural",
            "channel": "hair",
            "priority": "must",
            "character_goal": "hair_natural",
            "text": "保持本套主要发型；发根与发际线衔接自然，主发量有体积，次级发束粗细疏密有变化，发梢自然收束，高光随朝向变化，避免硬壳、胶结和等距亮丝。"
          },
          {
            "id": "CQ:face_readable",
            "channel": "hair",
            "priority": "must",
            "character_goal": "face_readable",
            "text": "本视角实际可见的眉眼、鼻口与面容辨识点清楚，禁止过多碎发遮脸；少量细发留在鬓角和轮廓边缘，不为整洁抹去全部自然细发。"
          }
        ],

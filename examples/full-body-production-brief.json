    {
      "id": "CQ:face_readable",
      "channel": "hair",
      "priority": "must",
      "character_goal": "face_readable",
      "text": "本视角实际可见的眉眼、鼻口与面容辨识点清楚，禁止过多碎发遮脸；少量细发留在鬓角和轮廓边缘，不为整洁抹去全部自然细发。"
    },

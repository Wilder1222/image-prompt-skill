{
  "subject_kind": "character",
  "request": "为当前原创成年女性制作一张单人肩部以上定妆肖像，面容结构由她的独立方案注入，按本轮妆肤与神态目标完成。这是文字设计演练。",
  "references": [],
  "unresolved": [],
  "requirements": [
    {
      "id": "benchmark-frame",
      "channel": "composition",
      "priority": "must",
      "text": "单人肩部以上正面平视肖像，头顶与发型完整入画，双眼、鼻唇和下颌清楚可见，四周有适度留白。"
    },
    {
      "id": "benchmark-proportion",
      "channel": "proportion",
      "priority": "must",
      "text": "仅检查可见头肩关系：人物自己的头部、颈部与肩部比例协调，肩颈舒展自然，颈部不拉长。",
      "character_goal": "elongated"
    },
    {
      "id": "benchmark-style",
      "channel": "style",
      "priority": "must",
      "text": "细腻美观的人物精修肖像，面容具有协调的完成度和可信体积，精修沿着人物原定骨相和软组织完成，保持成年年龄与独立眉眼鼻唇关系。"
    },
    {
      "id": "benchmark-costume",
      "channel": "costume",
      "priority": "must",
      "text": "可见米白色亚麻交领衣的领口和肩部，织物低光泽，领缘厚度及搭接自然。"
    },
    {
      "id": "benchmark-background",
      "channel": "background",
      "priority": "must",
      "text": "浅暖灰无缝背景，面部清楚，无文字、图表或其他人物。"
    },
    {
      "id": "CQ:slender",
      "channel": "proportion",
      "priority": "must",
      "character_goal": "slender",
      "text": "实际可见的身形苗条利落，轮廓自然收束且有连续厚度，不削成纸片或露骨细杆；衣装沿既定结构呈现。"
    },
    {
      "id": "CQ:muscle",
      "channel": "proportion",
      "priority": "must",
      "character_goal": "muscle",
      "text": "实际可见的身体适当有肌肉与软组织支撑，线条紧致舒展，不过分硬刻或夸大肌肉，不穿透衣装推断隐藏结构。"
    },
    {
      "id": "CQ:hair_natural",
      "channel": "hair",
      "priority": "must",
      "character_goal": "hair_natural",
      "text": "保持本套主要发型；发根与发际线衔接自然，主发量有体积，次级发束粗细疏密有变化，发梢自然收束，高光随朝向变化，避免硬壳、胶结和等距亮丝。"
    },
    {
      "id": "CQ:face_readable",
      "channel": "hair",
      "priority": "must",
      "character_goal": "face_readable",
      "text": "本视角实际可见的眉眼、鼻口与面容辨识点清楚，禁止过多碎发遮脸；少量细发留在鬓角和轮廓边缘，不为整洁抹去全部自然细发。"
    }
  ],

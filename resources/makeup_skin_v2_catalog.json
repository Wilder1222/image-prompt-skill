{
  "version": "0.7.7",
  "name": "makeup_skin_integration_v2",
  "controls": {
    "foundation_coverage": "light",
    "skin_visibility": "subtle_under_refined_makeup",
    "brow_density_variation": "natural",
    "eyeliner_edge": "softened",
    "lash_density": "moderate",
    "eyeshadow_blend": "anatomical",
    "blush": "low_saturation",
    "lip_coverage": "semi_transparent",
    "lip_color_uniformity": "slight_variation"
  },
  "prompt_translation": [
    "先建立精致完整且好看的妆面，面容真实感与肌肤纹理服务于美感，并保留人物身份和表观年龄。",
    "底妆贴肤细腻，眉毛与睫毛根部自然，眼影、腮红和唇妆与人物气质协调；克制的分区反射和轻微纹理支持妆面，不喧宾夺主。",
    "纹理强度适配景别和输出尺寸：全身小脸不强行显示毛孔，近景纹理也保持低对比与美感，避免粗糙锐化和塑料磨皮。"
  ],
  "forbidden": [
    "opaque_foundation_mask",
    "vector_eyeliner",
    "uniform_brow_stamp",
    "flat_lip_fill"
  ]
}

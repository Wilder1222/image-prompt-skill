{
  "version": "0.9.5",
  "principle": "每个视觉属性只指定一个主要参考来源；风格图不默认控制人物五官或衣片构造，用户明确授权的改案优先。权限数字是计划标识，不是模型权重。",
  "scenarios": {
    "style_A_asset_B": {
      "A": {
        "role": "style_target",
        "authority": {
          "medium_language": 3,
          "motion_language": 3,
          "lighting_language": 3,
          "atmosphere": 3,
          "composition_energy": 3,
          "color_relationships": 2,
          "environment_scale": 2,
          "face_identity_geometry": 0,
          "body_proportion": 0,
          "garment_silhouette": 0,
          "garment_structure": 0,
          "signature_accessories": 0
        }
      },
      "B": {
        "role": "asset_master",
        "authority": {
          "face_identity_geometry": 3,
          "body_proportion": 2,
          "garment_silhouette": 3,
          "garment_structure": 3,
          "signature_accessories": 3,
          "hairstyle_silhouette": 3,
          "palette_family": 2,
          "footwear_family": 2,
          "medium_language": 0,
          "environment_scale": 0
        }
      },
      "optional_C": {
        "role": "facial_trait",
        "authority": {
          "maturity_level": 2,
          "gaze_stability": 2,
          "makeup_restraint": 2
        },
        "forbidden": [
          "face_identity_geometry",
          "garment_structure",
          "lighting_language",
          "environment_scale"
        ]
      }
    },
    "identity_A_wardrobe_B": {
      "use_when": "用户授权换装或衣装再设计，且本轮明确指定图 B 为服装设计来源。",
      "A": {
        "role": "identity_source",
        "authority": {
          "face_identity_geometry": 3,
          "apparent_age": 3,
          "expression": 3,
          "hair_color": 3,
          "hairstyle_silhouette": 3,
          "garment_silhouette": 0,
          "garment_structure": 0,
          "palette_family": 0,
          "body_proportion": 0
        }
      },
      "B": {
        "role": "wardrobe_design_reference",
        "authority": {
          "garment_silhouette": 2,
          "garment_structure": 2,
          "palette_family": 2,
          "material_relationships": 2,
          "signature_accessories": 1,
          "face_identity_geometry": 0,
          "apparent_age": 0,
          "expression": 0,
          "hair_color": 0,
          "hairstyle_silhouette": 0,
          "body_proportion": 0,
          "pose": 0,
          "background": 0
        }
      },
      "brief_precedence": "文字改案决定允许的衣装变化、饰物数量、姿态与背景。用户明确的身体和发型要求优先；近景参考不能证明未见的身体测量。",
      "prompt_binding": [
        "图 A 是人物面容、表观年龄、发色与发型方向的主要来源；表情与发型可按本轮授权自然适配。",
        "图 B 仅提供衣装方案指定的衣片构造、配色、材质关系和选定饰品。不复制 B 的脸、体型、头发、额饰或未授权冠饰。",
        "明确的衣装改案优先于两图中冲突的服装细节。姿态与背景按本轮要求执行，不自动继承 B 的呈现。"
      ],
      "review": [
        "人物身份和发型对照 A，衣片构造对照 B，分别检查。",
        "检查 B 独有的脸、发型、额饰和体型是否误借；没有一个明显误借特征不等于身份已保持。",
        "按改案检查饰品数量与装饰密度，角色绑定文字不能保证模型不会加细节。",
        "B 必须记为实际生成输入，而不是仅评价标杆；该结果不属于纯提示词优化。"
      ]
    },
    "single_style_reference": {
      "A": {
        "role": "style_target_and_subject_source",
        "rule": "按通道拆分：可见人物与服装可作为主要依据，未见结构按保守延展处理，获准的画风通道可强继承。"
      }
    }
  },
  "levels": {
    "0": "ignore",
    "1": "weak",
    "2": "strong",
    "3": "strict"
  }
}

{
  "version": "0.8.2",
  "default": "elegant_crossed_hands_safe",
  "principle": "手部结构应在生成时就明确，不只作为出图后的补救项；手势由当前任务选择。",
  "modes": {
    "elegant_crossed_hands_safe": {
      "primary_hand": "front_top_hand",
      "secondary_hand": "supporting_lower_hand",
      "requirements": [
        "five_digits_each",
        "one_thumb_four_fingers_each",
        "natural_length_hierarchy",
        "believable_knuckles",
        "clear_wrist_direction",
        "sleeve_does_not_swallow_finger_roots",
        "hand_scale_matches_face_and_forearm"
      ],
      "prompt_translation": [
        "本交叠手势方案中，右手轻覆左手手背，放在下腹前；手指放松，手腕方向清楚，不十指交绞。",
        "每只手解剖上为一拇指与四指，自然交叠可遮挡部分手指，不强制十指全露；可见指节、手腕连接连续，袖口不吞没手部接触区。"
      ]
    },
    "relaxed_down_safe": {
      "requirements": [
        "five_digits_each",
        "relaxed_finger_curve",
        "clear_wrist_direction",
        "no_fusion"
      ],
      "prompt_translation": [
        "双手在身体两侧自然放松，五指解剖结构正确、腕部连续，允许姿态形成自然遮挡。"
      ]
    }
  }
}

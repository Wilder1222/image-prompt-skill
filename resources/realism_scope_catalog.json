{
  "version": "0.7.9",
  "principle": "面部与非面部真实感分别选择，再检查整体协调；精致妆面与视觉美感优先。",
  "modes": {
    "beauty_first": {
      "face_realism": "low_medium",
      "non_face_realism": "high",
      "face_edit_budget": "small",
      "non_face_edit_budget": "large"
    },
    "humanized_real": {
      "face_realism": "medium_high",
      "non_face_realism": "high",
      "face_edit_budget": "medium",
      "non_face_edit_budget": "large"
    },
    "stylized_beauty": {
      "face_realism": "low",
      "non_face_realism": "medium_high",
      "face_edit_budget": "very_small",
      "non_face_edit_budget": "medium"
    }
  },
  "non_face_channels": [
    "hair_strands",
    "body_presence",
    "hands",
    "costume_materials",
    "cloth_physics",
    "footwear",
    "lighting",
    "camera_response"
  ],
  "rule": "非面部的高真实感不自动要求面部同等摄影化；编辑预算只描述内部范围，不授权额外改脸、改身材或换装。"
}

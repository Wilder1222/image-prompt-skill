{
  "version": "0.8.1",
  "default": "concept_art_priority",
  "profiles": {
    "concept_art_priority": {
      "goal": "将细节集中于原画视觉重点，外围按用途适度概括。",
      "primary_detail": {
        "level": "high",
        "regions": [
          "face",
          "eyes",
          "crown_core",
          "chest_neck_focal",
          "waist_core_ornament",
          "weapon_core"
        ]
      },
      "secondary_detail": {
        "level": "medium",
        "regions": [
          "main_skirt_mass",
          "primary_sleeves",
          "primary_hair_masses",
          "main_crimson_ribbons",
          "major_accessories"
        ]
      },
      "atmospheric_detail": {
        "level": "low_selective",
        "regions": [
          "hair_tails",
          "outer_ribbons",
          "distant_architecture",
          "banners",
          "clouds_mist",
          "ground_reflection",
          "peripheral_particles"
        ]
      },
      "compiler_rules": [
        "最高细节集中在现有焦点结构。",
        "主要身体与衣装体块保持清楚可读。",
        "外围与远处可选择性概括，不能因此遗漏用户要求的衣装或全身轮廓。",
        "不因空白存在就增加纹样或饰品。"
      ],
      "anti_patterns": [
        "uniform_microdetail",
        "literal_everything_rendered",
        "peripheral_detail_competes",
        "background_same_resolution_as_face"
      ]
    },
    "commercial_balanced": {
      "goal": "商业插画中平衡人物、衣装与必要环境的细节。",
      "primary_detail": {
        "level": "high",
        "regions": [
          "face",
          "upper_body",
          "signature_ornaments"
        ]
      },
      "secondary_detail": {
        "level": "medium_high",
        "regions": [
          "garment",
          "hair",
          "weapon"
        ]
      },
      "atmospheric_detail": {
        "level": "medium",
        "regions": [
          "background",
          "effects"
        ]
      },
      "anti_patterns": [
        "background_sharper_than_subject"
      ]
    }
  },
  "scope": "区域列表仅处理当前设计实际存在的元素，不为补齐列表添加武器、冠饰、飘带或建筑。"
}

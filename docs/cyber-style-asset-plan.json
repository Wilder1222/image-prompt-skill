{
  "render_mode": {
    "mode": "style_asset",
    "priority": [
      "identity",
      "asset_continuity",
      "style_language",
      "human_presence",
      "material_realism",
      "neutral_background",
      "micro_quality"
    ],
    "background_policy": "white_or_neutral",
    "environment_copy": "forbidden"
  },
  "reference_fidelity": {
    "preset": "cyber_asset_case",
    "channels": {
      "identity": {
        "level": 3,
        "label": "strict"
      },
      "costume": {
        "level": 3,
        "label": "strict"
      },
      "material": {
        "level": 2,
        "label": "strong"
      },
      "pose": {
        "level": 2,
        "label": "strong"
      },
      "style": {
        "level": 2,
        "label": "strong"
      },
      "lighting": {
        "level": 1,
        "label": "weak"
      },
      "environment": {
        "level": 0,
        "label": "ignore"
      }
    },
    "rule": "同一输出属性最多有一个严格来源；这些等级是项目经验规则，不是厂商参数。"
  },
  "completion": {
    "level": "C1",
    "label": "conservative_completion",
    "new_major_design": false,
    "new_secondary_design": true,
    "density_delta": 0,
    "rule": "不可见区域仍是设计延展，不能视为观察事实。"
  },
  "human_presence": {
    "level": "H2",
    "label": "human_presence",
    "soft_tissue": "moderate",
    "regional_skin": "moderate",
    "natural_asymmetry": "subtle",
    "camera_response": "moderate",
    "age_shift": "none",
    "components": [
      "soft_tissue",
      "regional_skin_response",
      "natural_asymmetry",
      "camera_response"
    ],
    "rule": "人物生命感改变表现方式，不改变身份几何或年龄，除非用户明确要求。"
  },
  "density": {
    "design_density": "high",
    "density_policy": "preserve_reference_density",
    "zones": [
      "head",
      "torso",
      "waist",
      "arms",
      "lower_body",
      "footwear"
    ],
    "wear_state": {
      "level": "W2",
      "label": "distressed"
    },
    "rules": {
      "completion_default_delta": 0,
      "new_zone_must_not_exceed_reference_peak_without_authorization": true,
      "do_not_scale_decoration_count_with_canvas_area": true
    }
  },
  "prompt_skeleton": [
    "将参考中的人物身份与衣装构造作为主要资产来源。",
    "按忠实度矩阵使用参考的风格、材质和灯光通道，但保持白色或中性背景。",
    "按所选补全等级保守延展未见的下半身或鞋履，不创造新的主要设计纹样。",
    "新补全部分保持原有设计密度与磨损状态。",
    "通过软组织、分区肤质、细微自然不对称与摄影表现增加人物生命感，不重塑面容。"
  ],
  "note": "资产上的风格模式保留参考韵味，但不复制原环境。",
  "档案说明": {
    "性质": "历史计划或结果记录的中文译文；非当前默认，非新执行或重新评审",
    "源提交": "c8561d11115bc05c5e3e3c530cbc9320ecf8f857",
    "源文件": "docs/cyber-style-asset-plan.json",
    "源文件摘要": "c55f071e7a65f38ae4f976f1a5c0b04def557ca2b391da5c843be5528d52c86a",
    "边界": "原始输入输出摘要、分数、状态、时间、数量、命令、标识与结构保留。历史参考权限、白底、年龄、比例及手脚要求不覆盖当前用户任务。"
  }
}

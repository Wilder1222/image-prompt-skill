  "visual_review": {
    "inspected": true,
    "plot": "dist/technical-studies/anny-20261006/pose-bind-01/pose-ground-inspection.png",
    "observation": "实际查看正交侧投影：右髋正向探针足尖越过固定地面；右膝正向探针右脚出现间隙，左脚位置保持。骨架线与表面可对应。",
    "limitation": "只有三个侧面诊断图；没有对头颈、全身自交或所有探针姿态完成美术验收。"
  },
  "decisions": [
    "脚部是否离地必须检查表面相对地面，不以踝点高度代替；鞋履加上后需改查实际鞋底。",
    "原生膝关节正向探针可用于下一步坐标研究，不作为完整单支撑步态：骨盆、另一腿和摆臂尚未按目标调整。",
    "在旧缩头候选上继续摆姿前，先复核几何区域与绑定；不能直接把原生探针的空间结果转授给候选。",
    "下轮若改候选，显式保护胸肩顶点并检查头颈过渡；新绑定还需转头与抬臂等姿态检查，不能只看中性零姿态。"
  ],
  "limitations": [
    "角度为轴向探针，不是生理步态解；负向膝弯仅用于识别方向。",
    "未进行动力学、足底压力、蒙皮自交、衣装或动画连续性验收。",
    "原生体型不是九头身；缩头候选未更新骨架、蒙皮或衣装。",
    "骨骼头随几何映射的位置仅作差异诊断，不代表正确关节中心。"
  ],
